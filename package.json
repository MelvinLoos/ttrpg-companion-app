{
  "name": "ttrpg-companion-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" ",
    "typecheck": "vue-tsc -b --noEmit",
    "create-buckets": "tsx scripts/db/create-buckets.ts",
    "test:rls:assets": "node scripts/tests/session-assets-rls.mjs",
    "ruler:apply": "npx @intellectronica/ruler apply",
    "postinstall": "npx @intellectronica/ruler apply"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.76.1",
    "@tailwindcss/vite": "^4.1.17",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.6.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.7",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.1.0"
  }
}
