VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: skip auth initialization in development (test-only).
# When true, the GM routes remain accessible without signing in.
# VITE_SKIP_AUTH=true

# ---------------------------------------------------------------------------
# Test scripts (scripts/tests/*.mjs)
# ---------------------------------------------------------------------------
# Used by the Node.js test/seed scripts. Unlike the VITE_* vars above, these
# are NOT bundled into the frontend — they are read directly by Node at runtime
# and are intentionally NOT prefixed with VITE_.
#
# SUPABASE_URL defaults to http://127.0.0.1:54321 (local `supabase start`), but
# you can point it at a hosted project ref for remote testing.
# SUPABASE_URL=http://127.0.0.1:54321
#
# The publishable/anon key (same value as VITE_SUPABASE_ANON_KEY).
# SUPABASE_ANON_KEY=your-supabase-anon-key
#
# Service-role key — ONLY for admin operations in tests/scripts (e.g.
# creating users, seeding data). Never expose this to the browser or commit it.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
